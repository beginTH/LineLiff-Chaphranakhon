      "parameters": {
        "jsCode": "const adminMenu = 'richmenu-f2b991c0d0009f560f38ef78b034c606';\nconst branchMenu = 'richmenu-9e24dce8c6b1bc140f5d3f0c4c05ee75';\nconst admins = $items('Read Active Admins').map(i => i.json);\nconst users = $input.all().map(i => i.json);\nconst active = v => ['active','true','1','yes'].includes(String(v ?? '').trim().toLowerCase());\nconst rows = new Map();\nfor (const row of users) {\n  const uid = String(row.LINE_UID || row.lineUid || '').trim();\n  if (uid) rows.set(uid, { uid, role: String(row.Role || '').trim().toLowerCase(), blocked: String(row.Friend_Status || '').trim().toLowerCase() === 'blocked' });\n}\nfor (const row of admins) {\n  const uid = String(row.LINE_UID || row.lineUid || '').trim();\n  if (uid && active(row.Status)) rows.set(uid, { uid, role: 'admin', blocked: false });\n}\nreturn [...rows.values()].map(row => {\n  const menu = row.blocked ? '' : (row.role === 'admin' || row.role === 'superadmin' || row.role === 'approver' || row.role === 'owner' ? adminMenu : row.role === 'branch' ? branchMenu : '');\n  return { json: { LINE_UID: row.uid, action: menu ? 'link' : 'unlink', richMenuId: menu, role: row.role || 'customer' } };\n});"
      },
