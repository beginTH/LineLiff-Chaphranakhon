      "parameters": {
        "jsCode": "const headers=$json.headers||{}; const authorization=String(headers.authorization||headers.Authorization||'').trim(); const match=authorization.match(/^Bearer\\s+(.+)$/i); if(!match||!match[1]) throw new Error('Missing LINE ID token'); const idToken=match[1].trim(); if(idToken.length<100||idToken.length>5000) throw new Error('Invalid LINE ID token format'); return [{json:{idToken}}];"
