    {
      "parameters": {
        "jsCode": "const body=$node['POST /admin-product-update'].json.body||{}; const uid=String($node['Verify LINE Token for Product Update'].json.sub||'').trim(); const admins=$input.all().map(i=>i.json); const admin=admins.find(i=>String(i.LINE_UID||'').trim()===uid&&String(i.Status||'').trim().toLowerCase()==='active'); const role=String(admin?.Role||'').trim().toLowerCase(); if(!admin||!['owner','approve','approver'].includes(role)) throw new Error('Only an active owner or approver may update products'); const Product_ID=String(body.productId||'').trim(); const Unit=String(body.unit||'').trim(); const Price=Number(body.price); const Image_URL=String(body.imageUrl||'').trim(); const Status=String(body.status||'').trim().toLowerCase(); const Customer_Type=String(body.customerType||'').trim(); if(!Product_ID||!Unit||!Number.isFinite(Price)||Price<0) throw new Error('Invalid product data'); if(!['active','inactive','cancelled'].includes(Status)) throw new Error('Invalid product status'); if(Image_URL&&!/^https?:\\/\\//i.test(Image_URL)) throw new Error('Image URL must use http or https'); return [{json:{Product_ID,Unit,Price,Image_URL,Status,Customer_Type,Updated_At:new Date().toISOString(),Updated_By_UID:uid}}];"
      },
