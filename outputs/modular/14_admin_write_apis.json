        "jsCode": "const body=$node['POST /admin-user-role-update'].json.body||{}; const uid=String($node['Verify LINE Token for Role Update'].json.sub||'').trim(); const admins=$input.all().map(i=>i.json); const admin=admins.find(i=>String(i.LINE_UID||'').trim()===uid&&String(i.Status||'').trim().toLowerCase()==='active'); if(!admin||String(admin.Role||'').trim().toLowerCase()!=='owner') throw new Error('Only an active owner may update user roles'); const LINE_UID=String(body.lineUid||'').trim(); const Role=String(body.role||'').trim().toLowerCase(); if(!LINE_UID||!['customer','branch','owner','admin','superadmin'].includes(Role)) throw new Error('Invalid user role data'); if(LINE_UID===uid) throw new Error('You cannot change your own role'); return [{json:{LINE_UID,Role,Updated_At:new Date().toISOString(),Updated_By_UID:uid,Updated_By_Role:'owner'}}];"
