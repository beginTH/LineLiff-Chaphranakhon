      "parameters": {
        "jsCode": "const body=$node['POST /admin-product-update'].json.body||{}; const uid=String(body.uid||'').trim(); const ok=$input.all().some(i=>String(i.json.LINE_UID||'').trim()===uid&&String(i.json.Status||'').trim().toLowerCase()==='active'); if(!ok) throw new Error('Active admin UID is required'); const Product_ID=String(body.productId||'').trim(); const Unit=String(body.unit||'').trim(); const Price=Number(body.price); const Image_URL=String(body.imageUrl||'').trim(); const Status=String(body.status||'').trim().toLowerCase(); const Customer_Type=String(body.customerType||'').trim(); if(!Product_ID||!Unit||!Number.isFinite(Price)||Price<0) throw new Error('Invalid product data'); if(!['active','inactive','cancelled'].includes(Status)) throw new Error('Invalid product status'); if(Image_URL&&!/^https?:\\/\\//i.test(Image_URL)) throw new Error('Image URL must use http or https'); return [{json:{Product_ID,Unit,Price,Image_URL,Status,Customer_Type,Updated_At:new Date().toISOString(),Updated_By_UID:uid}}];"
      },
