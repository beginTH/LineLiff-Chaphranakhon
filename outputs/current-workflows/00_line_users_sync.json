      "id": "0d4b9574-49ca-4e88-bd2d-1e22c7217f9d",
      "name": "Read Existing Users",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [480, 0],
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "ZPODlcDmX45WFVuM",
          "name": "Google Sheets account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const existingRows = $input.all().map(item => item.json).filter(row => row.LINE_UID);\nconst existingByUid = new Map(existingRows.map(row => [String(row.LINE_UID).trim(), row]));\nconst events = $items('Extract User Events').map(item => item.json);\n\nreturn events.map(event => {\n  const old = existingByUid.get(event.LINE_UID) || {};\n  const firstAddedAt = old.First_Added_At || (event.Event_Type === 'follow' ? event.Event_At : event.Event_At);\n  return { json: {\n    ...event,\n    Display_Name: old.Display_Name || '',\n    Picture_URL: old.Picture_URL || '',\n    Language: old.Language || '',\n    Role: old.Role || 'customer',\n    Friend_Status: event.Is_Active ? 'active' : 'blocked',\n    First_Added_At: firstAddedAt,\n    Last_Interaction: event.Is_Active ? event.Event_At : (old.Last_Interaction || ''),\n    Registered_At: old.Registered_At || '',\n    Updated_At: event.Event_At,\n  } };\n});"
      },
      "id": "d67df1c5-acde-44bc-86f3-13c131760d5e",
      "name": "Merge Existing User Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 0]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.Is_Active }}",
              "value2": true
            }
          ]
        }
      },
      "id": "7695832d-acd1-43bb-8278-31fca36d0ea4",
      "name": "Is Active Friend?",
