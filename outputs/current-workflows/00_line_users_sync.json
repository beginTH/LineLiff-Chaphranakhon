      "id": "e437be8d-7e0a-4da1-9533-6149ce0a58f4",
      "name": "Get LINE Profile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, -120],
      "continueOnFail": true,
      "notesInFlow": true,
      "notes": "ก่อนเปิดใช้งาน ให้เปลี่ยน REPLACE_WITH_LINE_CHANNEL_ACCESS_TOKEN หรือใช้ Header Auth credential ที่เก็บ token อย่างปลอดภัย"
    },
    {
      "parameters": {
        "jsCode": "const base = $('Merge Existing User Data').item.json;\nconst profile = $json || {};\nconst profileOk = !profile.error && !profile.errorCode && (profile.displayName || profile.userId);\nreturn [{ json: {\n  ...base,\n  Display_Name: profileOk ? (profile.displayName || base.Display_Name) : base.Display_Name,\n  Picture_URL: profileOk ? (profile.pictureUrl || base.Picture_URL) : base.Picture_URL,\n  Language: profileOk ? (profile.language || base.Language) : base.Language,\n} }];"
      },
