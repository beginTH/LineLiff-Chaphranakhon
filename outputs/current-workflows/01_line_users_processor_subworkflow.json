    {"parameters": {"jsCode": "const supported = new Set(['follow', 'message', 'postback', 'unfollow']);\nreturn $input.all().flatMap(item => {\n  const event = item.json || {};\n  const uid = String(event?.source?.userId || '').trim();\n  if (!uid || !supported.has(event.type)) return [];\n  const timestamp = Number(event.timestamp || Date.now());\n  return [{ json: {\n    LINE_UID: uid, Event_Type: event.type, Event_At: new Date(timestamp).toISOString(),\n    Is_Active: event.type !== 'unfollow',\n  } }];\n});"}, "id": "2b0e1ee5-d3d1-4997-b6e9-42239dc75d5c", "name": "Normalize LINE Event", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [220,0]},
