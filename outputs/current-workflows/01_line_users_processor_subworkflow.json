    {"parameters":{"jsCode":"const rows = $input.all().map(i => i.json).filter(r => r.LINE_UID);\nconst existing = new Map(rows.map(r => [String(r.LINE_UID).trim(), r]));\nreturn $items('Normalize LINE Event').map(item => {\n  const event = item.json; const old = existing.get(event.LINE_UID) || {};\n  return { json: {\n    ...event, Display_Name: old.Display_Name || '', Picture_URL: old.Picture_URL || '', Language: old.Language || '',\n    Role: old.Role || 'customer', Friend_Status: event.Is_Active ? 'active' : 'blocked',\n    First_Added_At: old.First_Added_At || event.Event_At,\n    Last_Interaction: event.Is_Active ? event.Event_At : (old.Last_Interaction || ''),\n    Registered_At: old.Registered_At || '', Updated_At: event.Event_At,\n  } };\n});"},"id":"36c675ca-d42d-44bf-b9ea-eac2db1ff322","name":"Merge Existing User Data","type":"n8n-nodes-base.code","typeVersion":2,"position":[680,0]},
